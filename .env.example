# SAKAN EUROPE — server-side environment variables only.
# Add real values in Vercel Project Settings > Environment Variables.
# NEVER commit a real .env file or place secrets in index.html.

# CJ Dropshipping API 2.0 authentication:
# Set CJ_ACCESS_TOKEN if CJ already supplied an access token.
# Otherwise set CJ_API_KEY (the key from My CJ > Authorization > API).
CJ_ACCESS_TOKEN=
CJ_API_KEY=
CJ_REFRESH_TOKEN=
CJ_LOGISTIC_NAME=
CJ_FROM_COUNTRY_CODE=CN
CJ_SANDBOX=1

# Stripe (keep unset until checkout and database are configured and tested)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal REST API (keep unset until checkout and database are configured and tested)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Database used to persist orders and webhook idempotency records.
DATABASE_URL=
